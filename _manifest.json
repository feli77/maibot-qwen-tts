{
  "manifest_version": 2,
  "id": "local.qwen-tts",
  "version": "1.2.0",
  "name": "Qwen3-TTS QQ 语音",
  "description": "使用本机 Qwen3-TTS 模型合成语音，并通过 MaiBot 的 QQ 适配器发到当前会话。",
  "author": {"name": "feli77", "url": "https://github.com/feli77"},
  "license": "MIT",
  "urls": {"repository": "https://github.com/feli77/maibot-qwen-tts"},
  "host_application": {"min_version": "1.3.18", "max_version": "1.4.99"},
  "sdk": {"min_version": "2.19.0", "max_version": "2.99.99"},
  "plugin_type": "media",
  "dependencies": [
    {"type": "python_package", "name": "uv", "version_spec": ">=0.10,<1"}
  ],
  "capabilities": ["send.custom", "send.text"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
